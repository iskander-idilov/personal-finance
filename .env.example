# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env

# Пароль пользователя PostgreSQL (используется приложением и обоими контейнерами БД — основным и тестовым).
# Обязательное значение, приложение не запустится без него.
DB_PASSWORD=

# Имя пользователя PostgreSQL. Необязательно — по умолчанию "postgres".
POSTGRES_USER=

# Название базы данных PostgreSQL. Необязательно — по умолчанию "BitLab".
POSTGRES_DB=

# API-ключ Finnhub.io (котировки акций и финансовые новости). Получить на https://finnhub.io/
# Обязательное значение, приложение не запустится без него.
FINNHUB_API_KEY=
