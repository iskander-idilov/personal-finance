<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="add-category-user-column" author="iskander">
        <addColumn tableName="category">
            <column name="user_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="category" baseColumnNames="user_id" constraintName="fk_category_user"
                                 referencedTableName="users" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="backfill-missing-accounts" author="iskander">
        <sql>
            INSERT INTO account (balance, user_id)
            SELECT 0, u.id FROM users u
            WHERE NOT EXISTS (SELECT 1 FROM account a WHERE a.user_id = u.id);
        </sql>
    </changeSet>

</databaseChangeLog>
